# =============================================================================
# Makefile.all — Sequential Meta-Profiling: eBPF + Go API
# =============================================================================
# Runs both experiments back-to-back with proper cleanup between them.
# Results are pushed to GitHub after each experiment completes.
#
# Usage:   make -f Makefile.all
#
# Flow:
#   Phase 1 — eBPF dummy workload test     (~67 min)
#     → compile dummy_workload
#     → run 1000-iteration bpftrace measurement
#     → cleanup temp files + kill processes
#     → git push results
#
#   Phase 2 — Go API perf test             (~33 hours)
#     → docker compose up
#     → k6 load generator
#     → run 1000-iteration perf stat measurement
#     → stop k6 + docker compose down
#     → cleanup temp files
#     → git push results
#
# System:  Intel Xeon E5-2620 v4 (32 CPUs, isolated: 6,7,14,15)
#
# Prerequisites:
#   sudo apt install -y bpftrace
# =============================================================================

.PHONY: all run-ebpf run-goapi clean
.NOTPARALLEL:

# ---------------------------------------------------------------------------
# Shared config
# ---------------------------------------------------------------------------
STACK_DIR     = ..
RESULTS_DIR   = results
TIMESTAMP     = $(shell date +%Y%m%d_%H%M%S)

# ---------------------------------------------------------------------------
# Phase 1: eBPF config
# ---------------------------------------------------------------------------
EBPF_ITERATIONS  = 1000
EBPF_DURATION    = 2
EBPF_RESULTS     = $(RESULTS_DIR)/ebpf_overhead_$(TIMESTAMP).csv
WORKLOAD_CPU     = 6
EBPF_TOOL_CPU    = 7
EBPF_MEASURE_CPU = 14

# ---------------------------------------------------------------------------
# Phase 2: Go API config
# ---------------------------------------------------------------------------
GOAPI_ITERATIONS = 1000
GOAPI_DURATION   = 15
GOAPI_RESULTS    = $(RESULTS_DIR)/goapi_ebpf_overhead_$(TIMESTAMP).csv

# =============================================================================
# Main target — runs both phases sequentially
# =============================================================================
all:
	@echo ""
	@echo "╔══════════════════════════════════════════════════════════════════╗"
	@echo "║     Sequential Meta-Profiling — eBPF + Go API                  ║"
	@echo "║                                                                ║"
	@echo "║  Phase 1: eBPF dummy workload   ($(EBPF_ITERATIONS) × $(EBPF_DURATION)s ≈ 67 min)          ║"
	@echo "║  Phase 2: Go API eBPF          ($(GOAPI_ITERATIONS) × $(GOAPI_DURATION)s ≈ 8.5 hours)       ║"
	@echo "╚══════════════════════════════════════════════════════════════════╝"
	@echo ""
	@mkdir -p $(RESULTS_DIR)
	$(MAKE) -f Makefile.all run-ebpf
	@echo ""
	@echo "  ⏳ Phase 1 complete. Starting Phase 2 in 10 seconds..."
	@sleep 10
	$(MAKE) -f Makefile.all run-goapi
	@echo ""
	@echo "╔══════════════════════════════════════════════════════════════════╗"
	@echo "║  ✅ ALL EXPERIMENTS COMPLETE                                    ║"
	@echo "║  Results:                                                       ║"
	@echo "║    Phase 1 (eBPF):   $(EBPF_RESULTS)"
	@echo "║    Phase 2 (Go API): $(GOAPI_RESULTS)"
	@echo "╚══════════════════════════════════════════════════════════════════╝"

# =============================================================================
# Phase 1: eBPF Dummy Workload Test
# =============================================================================
# CPU pinning:
#   dummy_workload:  CPU 6  (Core 6, Socket 0) — isolated
#   perf record:     CPU 7  (Core 7, Socket 0) — isolated
#   bpftrace:        CPU 14 (Core 6, Socket 1) — isolated
# =============================================================================
run-ebpf:
	@echo "=================================================================="
	@echo "  PHASE 1: eBPF Dummy Workload Test"
	@echo "  Iterations: $(EBPF_ITERATIONS) | Window: $(EBPF_DURATION)s"
	@echo "  CPU pinning: workload=$(WORKLOAD_CPU) perf=$(EBPF_TOOL_CPU) bpftrace=$(EBPF_MEASURE_CPU)"
	@echo "  Results: $(EBPF_RESULTS)"
	@echo "=================================================================="
	@echo ""
	@# ---- Compile ----
	gcc dummy_workload.c -o dummy_workload
	@echo "  ✅ Compiled dummy_workload"
	@echo ""
	@# ---- Run test ----
	@taskset -c $(WORKLOAD_CPU) ./dummy_workload > /dev/null & \
	PID=$$!; \
	echo "  Workload PID: $$PID (CPU $(WORKLOAD_CPU))"; \
	sleep 1; \
	echo "  Starting eBPF measurement..."; \
	sudo python3 measure_statistically_ebpf.py \
		--iterations $(EBPF_ITERATIONS) \
		--duration $(EBPF_DURATION) \
		--pid $$PID \
		--output $(EBPF_RESULTS); \
	echo ""; \
	echo "  Stopping workload..."; \
	kill -9 $$PID 2>/dev/null || true; \
	echo "  ✅ Workload killed."
	@echo ""
	@# ---- Cleanup ----
	@echo "  Cleaning up Phase 1..."
	@rm -f dummy_workload
	@sudo rm -f /tmp/perf-experiment.data /tmp/base_metrics.csv /tmp/tool_metrics.csv
	@sudo pkill -9 -x perf 2>/dev/null || true
	@sudo pkill -9 -x bpftrace 2>/dev/null || true
	@echo "  ✅ Phase 1 cleanup done."
	@echo ""
	@# ---- Push to GitHub ----
	@echo "  Pushing Phase 1 results to GitHub..."
	@cd $(STACK_DIR) && \
	git config user.name "Perf Auto-Runner" && \
	git config user.email "runner@performance-analysis.local" && \
	git add -A && \
	git commit -m "results: eBPF dummy workload overhead ($(EBPF_ITERATIONS)×$(EBPF_DURATION)s) — $$(date '+%Y-%m-%d %H:%M')" && \
	git push origin $$(git branch --show-current) && \
	echo "  ✅ Phase 1 results pushed to GitHub!" || \
	echo "  ⚠️  Git push failed. Results saved locally: $(EBPF_RESULTS)"
	@echo ""
	@echo "  ══════════════════════════════════════"
	@echo "  ✅ PHASE 1 COMPLETE"
	@echo "  ══════════════════════════════════════"

# =============================================================================
# Phase 2: Go API Perf Test
# =============================================================================
# CPU pinning (from measure_statistically.py):
#   perf record:  CPUs 6,14 — isolated
#   perf stat:    CPUs 7,15 — isolated
#   Go API:       unpinned (runs on non-isolated CPUs via Docker)
# =============================================================================
run-goapi:
	@echo "=================================================================="
	@echo "  PHASE 2: Go API Perf Test"
	@echo "  Iterations: $(GOAPI_ITERATIONS) | Window: $(GOAPI_DURATION)s"
	@echo "  Results: $(GOAPI_RESULTS)"
	@echo "=================================================================="
	@echo ""
	@# ---- Start Docker stack ----
	@echo "  Starting Docker microservice stack..."
	cd $(STACK_DIR) && docker compose up -d --build
	@echo "  Waiting 60s for services to become healthy..."
	@sleep 60
	@cd $(STACK_DIR) && docker compose ps
	@echo ""
	@# ---- Start k6 + find PID + run test ----
	@echo "  Starting k6 load generator..."
	k6 run --quiet --duration 600m $(STACK_DIR)/loadtest/highload.js > /tmp/k6_output.log 2>&1 & \
	echo $$! > /tmp/k6_pid.txt
	@echo "  k6 PID: $$(cat /tmp/k6_pid.txt)"
	@echo "  Warming up for 30s..."
	@sleep 30
	@echo "  Discovering Go API PID..."
	@API_PID=$$(pgrep -f '^/api$$' | head -n1); \
	if [ -z "$$API_PID" ]; then \
		echo "ERROR: Could not find Go API PID. Is perf-go-api running?"; \
		exit 1; \
	fi; \
	echo "  Go API PID: $$API_PID"; \
	echo ""; \
	echo "  Starting eBPF measurement (15s window)..."; \
	echo "  Estimated time: ~$$(( $(GOAPI_ITERATIONS) * $(GOAPI_DURATION) * 2 / 60 + 5 )) minutes"; \
	echo ""; \
	sudo python3 measure_statistically_ebpf.py \
		--iterations $(GOAPI_ITERATIONS) \
		--duration $(GOAPI_DURATION) \
		--pid $$API_PID \
		--output $(GOAPI_RESULTS)
	@echo ""
	@# ---- Stop k6 ----
	@echo "  Stopping k6..."
	@kill $$(cat /tmp/k6_pid.txt) 2>/dev/null || true
	@rm -f /tmp/k6_pid.txt
	@echo "  ✅ k6 stopped."
	@echo ""
	@# ---- Stop Docker stack ----
	@echo "  Stopping Docker stack..."
	cd $(STACK_DIR) && docker compose down
	@echo "  ✅ Docker stack stopped."
	@echo ""
	@# ---- Cleanup ----
	@echo "  Cleaning up Phase 2..."
	@rm -f /tmp/k6_output.log
	@sudo rm -f /tmp/perf-experiment.data /tmp/base_metrics.csv /tmp/tool_metrics.csv
	@sudo pkill -9 -x perf 2>/dev/null || true
	@echo "  ✅ Phase 2 cleanup done."
	@echo ""
	@# ---- Push to GitHub ----
	@echo "  Pushing Phase 2 results to GitHub..."
	@cd $(STACK_DIR) && \
	sudo -u $${SUDO_USER:-$$USER} -H git config user.name "Perf Auto-Runner" && \
	sudo -u $${SUDO_USER:-$$USER} -H git config user.email "runner@performance-analysis.local" && \
	sudo -u $${SUDO_USER:-$$USER} -H git add -A && \
	sudo -u $${SUDO_USER:-$$USER} -H git commit -m "results: Go API perf overhead ($(GOAPI_ITERATIONS)×$(GOAPI_DURATION)s) — $$(date '+%Y-%m-%d %H:%M')" && \
	sudo -u $${SUDO_USER:-$$USER} -H git push origin $$(git branch --show-current) && \
	echo "  ✅ Phase 2 results pushed to GitHub!" || \
	echo "  ⚠️  Git push failed. Results saved locally: $(GOAPI_RESULTS)"
	@echo ""
	@echo "  ══════════════════════════════════════"
	@echo "  ✅ PHASE 2 COMPLETE"
	@echo "  ══════════════════════════════════════"

# =============================================================================
# Emergency cleanup — kills everything and tears down Docker
# =============================================================================
clean:
	@echo "Emergency cleanup..."
	@kill $$(cat /tmp/k6_pid.txt) 2>/dev/null || true
	@rm -f /tmp/k6_pid.txt /tmp/k6_output.log
	@rm -f dummy_workload
	@sudo rm -f /tmp/perf-experiment.data /tmp/base_metrics.csv /tmp/tool_metrics.csv
	@sudo pkill -9 -x perf 2>/dev/null || true
	@sudo pkill -9 -x bpftrace 2>/dev/null || true
	@sudo pkill -9 -f dummy_workload 2>/dev/null || true
	cd $(STACK_DIR) && docker compose down 2>/dev/null || true
	@echo "✅ All cleaned."
