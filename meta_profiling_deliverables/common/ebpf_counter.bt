#!/usr/bin/env bpftrace
/*
 * ebpf_counter.bt — Timed eBPF hardware/software event counter
 *
 * Usage: sudo bpftrace ebpf_counter.bt <PID> <DURATION_SECONDS>
 *
 * NOTE: Deliberately avoids BEGIN/END probes to work around the
 *       "Could not resolve symbol: /proc/self/exe:BEGIN_trigger"
 *       bug in bpftrace 0.14.0 (Ubuntu 22.04 stripped binary).
 *       Uses interval:s:1 for countdown and CSV output instead.
 *
 * OPTIMISED for counting events of LOW-ACTIVITY processes such as
 * perf record.  The overflow periods are set LOW so that the probes
 * fire frequently enough to give accurate extrapolated counts even
 * when the target PID accumulates relatively few events.
 *
 * Sampling periods (events between probe firings):
 *   cycles:                    10,000   (extrapolate: count × 10,000)
 *   cache-misses:                 100   (extrapolate: count ×    100)
 *   branch-misses:                100   (extrapolate: count ×    100)
 *   page-faults:                    1   (exact count)
 *   context-switches:               1   (exact count)
 *
 * Why these periods?
 *   perf record is event-driven: it wakes up to drain ring buffers
 *   then sleeps.  Over a 5-second window it may accumulate only
 *   ~5-50M cycles, ~500-5000 cache-misses, ~200-2000 branch-misses.
 *   With the OLD periods (100K / 1K / 1K) the overflow count for
 *   cache-misses could be ZERO, making the measurement useless.
 *   Lower periods ensure enough overflows for meaningful counts.
 *
 * PMU counter budget (Broadwell, 4 GP + 3 fixed):
 *   cycles        → fixed counter #0 (free)
 *   cache-misses  → GP #1
 *   branch-misses → GP #2
 *   page-faults, context-switches → software (no PMU)
 *   Total: 1 fixed + 2 GP → NO multiplexing ✓
 *
 * Output format (between CSV_START / CSV_END markers):
 *   <metric>,<raw_overflow_count>,<period>
 *
 * The caller multiplies count × period to get the extrapolated value.
 * Software events (period=1) are exact counts with zero extrapolation error.
 */

/*
 * Hardware events — overflow-based counting.
 * The probe fires every <period> events for the filtered PID.
 * We count overflows and multiply by the period to extrapolate.
 *
 * NOTE: The PID filter is a BPF-level filter.  The overflow interrupt
 * fires for ALL processes on all CPUs, but the BPF program only
 * increments the counter when pid matches the target.  This means
 * we capture events from the target PID regardless of which CPU it
 * runs on (important since perf record is pinned to CPU 7).
 */

hardware:cycles:10000
/pid == $1/
{
    @cycles++;
}

hardware:cache-misses:100
/pid == $1/
{
    @cache_misses++;
}

hardware:branch-misses:100
/pid == $1/
{
    @branch_misses++;
}

/*
 * Software events — exact counting (period = 1).
 * Every single event triggers the probe, so the count is exact.
 */

software:page-faults:1
/pid == $1/
{
    @page_faults++;
}

software:context-switches:1
/pid == $1/
{
    @ctx_switches++;
}

/*
 * Timer — fires every second.
 * After $2 seconds: prints CSV output, clears all maps, exits.
 * Clearing maps before exit() prevents bpftrace's default map dump.
 */
interval:s:1
{
    @ticks++;
    if (@ticks >= $2) {
        printf("\nCSV_START\n");
        printf("cycles,%d,10000\n",                   @cycles);
        printf("cache-misses,%d,100\n",               @cache_misses);
        printf("branch-misses,%d,100\n",              @branch_misses);
        printf("page-faults,%d,1\n",                  @page_faults);
        printf("context-switches,%d,1\n",             @ctx_switches);
        printf("CSV_END\n");

        clear(@cycles);
        clear(@cache_misses);
        clear(@branch_misses);
        clear(@page_faults);
        clear(@ctx_switches);
        clear(@ticks);
        exit();
    }
}
