#!/usr/bin/env bpftrace
/*
 * ebpf_counter.bt — Timed eBPF hardware/software event counter
 *
 * Usage: sudo bpftrace ebpf_counter.bt <PID> <DURATION_SECONDS>
 *
 * NOTE: Deliberately avoids BEGIN/END probes to work around the
 *       "Could not resolve symbol: /proc/self/exe:BEGIN_trigger"
 *       bug in bpftrace 0.14.0 (Ubuntu 22.04 stripped binary).
 *       Uses interval:s:1 for countdown and CSV output instead.
 *
 * Sampling periods (events between probe firings):
 *   cycles:           100,000   (extrapolate: count × 100,000)
 *   cache-misses:       1,000   (extrapolate: count ×   1,000)
 *   branch-misses:      1,000   (extrapolate: count ×   1,000)
 *   page-faults:            1   (exact count)
 *   context-switches:       1   (exact count)
 *
 * Output format (between CSV_START / CSV_END markers):
 *   <metric>,<raw_overflow_count>,<period>
 *
 * The caller multiplies count × period to get the extrapolated value.
 * Software events (period=1) are exact counts with zero extrapolation error.
 */

/*
 * Hardware events — overflow-based sampling.
 * The probe fires every <period> events. We count overflows and
 * multiply by the period to extrapolate the total.
 * PID filter ensures we only count events from the target process.
 */

hardware:cycles:100000
/pid == $1/
{
    @cycles++;
}

hardware:cache-misses:1000
/pid == $1/
{
    @cache_misses++;
}

hardware:branch-misses:1000
/pid == $1/
{
    @branch_misses++;
}

/*
 * Software events — exact counting (period = 1).
 * Every single event triggers the probe, so the count is exact.
 */

software:page-faults:1
/pid == $1/
{
    @page_faults++;
}

software:context-switches:1
/pid == $1/
{
    @ctx_switches++;
}

/*
 * Timer — fires every second.
 * After $2 seconds: prints CSV output, clears all maps, exits.
 * Clearing maps before exit() prevents bpftrace's default map dump.
 */
interval:s:1
{
    @ticks++;
    if (@ticks >= $2) {
        printf("\nCSV_START\n");
        printf("cycles,%d,100000\n",           @cycles);
        printf("cache-misses,%d,1000\n",       @cache_misses);
        printf("branch-misses,%d,1000\n",      @branch_misses);
        printf("page-faults,%d,1\n",           @page_faults);
        printf("context-switches,%d,1\n",      @ctx_switches);
        printf("CSV_END\n");

        clear(@cycles);
        clear(@cache_misses);
        clear(@branch_misses);
        clear(@page_faults);
        clear(@ctx_switches);
        clear(@ticks);
        exit();
    }
}
